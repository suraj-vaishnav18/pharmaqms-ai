# Copy this file to .env and fill in real values. Never commit .env.

# Local SQLite database (default, zero setup - just a file on disk)
DATABASE_URL=sqlite:///./aivoa_complaints.db

# If/when you set up Postgres, comment the line above and use this instead:
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/aivoa_complaints

# Get a free key at https://console.groq.com
GROQ_API_KEY=your_groq_api_key_here

# Models used by the LangGraph pipeline
GROQ_FAST_MODEL=gemma2-9b-it
GROQ_REASONING_MODEL=llama-3.3-70b-versatile

# CORS - your frontend dev server
FRONTEND_ORIGIN=http://localhost:5173
